# ============================================================================
# Environment Variables for Human Hunter (AI Group Chat)
# ============================================================================
# Copy this file to .env and fill in your values
# For detailed documentation, see ENVIRONMENT_REFERENCE.md
# ============================================================================

# ============================================================================
# REQUIRED: API Keys
# ============================================================================

# OpenAI API Key (required for AI functionality)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Multiple API keys for high-traffic deployments (100+ concurrent users)
# Distributes load across keys using round-robin per room
# Comma-separated, takes precedence over OPENAI_API_KEY if set
# OPENAI_API_KEYS=sk-key1...,sk-key2...,sk-key3...

# Alternative AI providers (optional)
# ANTHROPIC_API_KEY=sk-ant-xxxxx
# GEMINI_API_KEY=xxxxx

# ============================================================================
# GAME CONFIGURATION
# ============================================================================

# Number of AI players per game (2-10)
NUM_AI_PLAYERS=4

# AI model settings
AI_MODEL_PROVIDER=openai          # Options: openai, anthropic, groq
AI_MODEL_NAME=gpt-4o-mini         # Model to use (gpt-4o-mini recommended)
AI_TEMPERATURE=0.8                # 0.0-2.0, higher = more creative

# Game timing (in seconds)
DISCUSSION_TIME=180               # Discussion phase (default: 3 minutes)
VOTING_TIME=60                    # Voting phase (default: 1 minute)

# Win condition
ROUNDS_TO_WIN=3                   # Rounds human must survive to win

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# DEVELOPMENT: SQLite (simple, no setup required)
DATABASE_URL=sqlite+aiosqlite:///./group_chat.db

# PRODUCTION: PostgreSQL (required for 10+ concurrent users)
# Managed services (no sudo): Supabase, Neon, Railway, ElephantSQL
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/database_name
#
# Examples:
# Supabase:  postgresql+asyncpg://postgres:pass@db.xxx.supabase.co:5432/postgres
# Neon:      postgresql+asyncpg://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb
# Railway:   postgresql+asyncpg://postgres:pass@containers-xxx.railway.app:5432/railway

# ============================================================================
# SECURITY CONFIGURATION (CRITICAL FOR PRODUCTION)
# ============================================================================

# Environment mode: 'development' or 'production'
# Production mode enforces security checks and fails on insecure config
ENVIRONMENT=development

# JWT Secrets - MUST be unique in production!
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# WARNING: Server will refuse to start in production with default values
JWT_SECRET_KEY=your-secret-key-change-this-in-production
JWT_COMPLETION_SECRET=your-completion-key-secret-change-this

# CORS: Allowed origins for API requests (comma-separated)
# Development: include localhost
# Production: ONLY include your actual frontend domain(s)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================================================
# MTURK INTEGRATION (Optional - for payment system)
# ============================================================================

# AWS Credentials for MTurk API
# Get from: AWS IAM Console
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# MTurk Environment
# 'sandbox' = testing (no real money)
# 'production' = real workers and payments (use with caution!)
MTURK_ENVIRONMENT=sandbox

# Payment configuration (in USD)
MTURK_BASE_PAY=0.05               # Base payment per completed HIT
MTURK_MAX_BONUS=0.05              # Maximum bonus per HIT

# Public URL for MTurk ExternalQuestion (must be HTTPS in production)
EXTERNAL_URL=https://your-app.netlify.app/lobby 

# MTurk iframe height (0 = auto-resize)
MTURK_FRAME_HEIGHT=0

# ============================================================================
# GEM ECONOMY & CASHOUT
# ============================================================================

# Gem rewards (1000 gems = $1.00 USD)
SINGLE_HUMAN_BASE_GEMS=50         # Base gems for single-human games
MULTI_HUMAN_BASE_GEMS=100         # Base gems for multi-human games
STAKE_PERCENTAGE=0.5              # Percentage of balance used as stake

# Cashout settings
MINIMUM_CASHOUT_AMOUNT=2.00       # Minimum USD to request cashout (2000 gems)
CASHOUT_MONITOR_INTERVAL=3600     # Check for expired codes (seconds)

# Standing HIT ID for cashouts
# Create with: python backend/create_standing_hit.py
# Then paste the HIT ID here
CASHOUT_HIT_ID=

# ============================================================================
# FRONTEND CONFIGURATION (for frontend .env or VITE_ prefix)
# ============================================================================

# Backend URL for frontend to connect to
# Local development uses http://localhost:8000 by default
# For cloud frontend, set to your backend URL
# VITE_BACKEND_URL=https://your-backend.railway.app

# ============================================================================
# PRODUCTION CHECKLIST
# ============================================================================
# Before deploying to production, ensure:
# [ ] ENVIRONMENT=production
# [ ] JWT_SECRET_KEY is a unique, secure random string
# [ ] JWT_COMPLETION_SECRET is a unique, secure random string
# [ ] DATABASE_URL points to PostgreSQL (not SQLite)
# [ ] CORS_ALLOWED_ORIGINS contains only your frontend domain(s)
# [ ] OPENAI_API_KEYS has 3+ keys for high-traffic deployments
# [ ] All URLs use HTTPS
# [ ] AWS credentials are set if using MTurk
# ============================================================================
