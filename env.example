# Environment Variables for AI Group Chat
# Copy this file to .env and fill in your values

# Required: OpenAI API Key
# For single API key (works for small deployments):
OPENAI_API_KEY=your-openai-api-key-here

# OR for multiple API keys (recommended for 100+ concurrent users):
# Distributes API load across multiple keys using round-robin
# Comma-separated list of OpenAI API keys
# OPENAI_API_KEYS=sk-key1...,sk-key2...,sk-key3...
#
# When OPENAI_API_KEYS is set, it takes precedence over OPENAI_API_KEY
# Each room/session will be assigned one key in rotation:
# - Room 1 → Key 1
# - Room 2 → Key 2  
# - Room 3 → Key 3
# - Room 4 → Key 1 (cycles back)
# This helps avoid rate limits with many concurrent users

# Optional: Backend URL (for frontend to connect to)
# When running locally, this defaults to http://localhost:8000
# For Streamlit Cloud, set this to your ngrok URL or cloud backend URL
# BACKEND_URL=https://your-ngrok-url.ngrok-free.app

# Optional: Game Configuration (see backend/config.py for more options)
# NUM_AI_PLAYERS=4
# AI_MODEL_NAME=gpt-4o-mini
# DISCUSSION_TIME=180
# VOTING_TIME=60
# ROUNDS_TO_WIN=3

# Database Configuration (Required for MTurk data collection)
# 
# DEVELOPMENT (current): SQLite - simple but limited concurrency
DATABASE_URL=sqlite+aiosqlite:///./group_chat.db
#
# PRODUCTION (recommended): PostgreSQL with connection pooling
# For 100+ concurrent users, MUST migrate to PostgreSQL!
# Managed services (no sudo required): Supabase, Neon, Railway
# Example: DATABASE_URL=postgresql+asyncpg://user:pass@host:port/group_chat_db
# See: SQLITE_TO_POSTGRESQL.md for migration guide

# JWT Secrets (CRITICAL - MUST change these in production!)
# Generate secure keys with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# SECURITY WARNING: Never commit real secrets to git!
JWT_SECRET_KEY=your-secret-key-change-this-in-production
JWT_COMPLETION_SECRET=your-completion-key-secret-change-this

# Environment Mode (set to 'production' to enable security validations)
# IMPORTANT: Set ENVIRONMENT=production when deploying
ENVIRONMENT=development

# MTurk Configuration (Required for automated payment system)
# AWS Credentials (get from AWS IAM console)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# MTurk Environment: 'sandbox' for testing, 'production' for real workers
MTURK_ENVIRONMENT=sandbox

# Base payment per completed HIT (in USD)
MTURK_BASE_PAY=0.05

# Maximum bonus per HIT (in USD) - caps the performance bonus
# Total max payment = MTURK_BASE_PAY + MTURK_MAX_BONUS
MTURK_MAX_BONUS=0.05

# Public URL where your game is hosted (for MTurk ExternalQuestion)
# This must be a publicly accessible HTTPS URL
# For production: Use your Netlify frontend URL
EXTERNAL_URL=https://ai-group-chat.netlify.app/lobby

# Frame height for MTurk iframe (0 = auto-resize)
MTURK_FRAME_HEIGHT=0

# CORS Configuration (Security: specify allowed origins)
# Comma-separated list of allowed origins for CORS
# IMPORTANT: Include your Netlify frontend URL for production
# For development: include localhost URLs
# For production: include your actual frontend domain
CORS_ALLOWED_ORIGINS=https://ai-group-chat.netlify.app,http://localhost:5173,http://localhost:3000

# Gem Economy & Cashout Configuration
# Players earn gems by playing games (1000 gems = $1.00 USD)
# They cash out by getting a redemption code and submitting it to a standing MTurk HIT

# Minimum cashout amount in USD
MINIMUM_CASHOUT_AMOUNT=2.00

# How often to check for expired redemption codes (in seconds)
CASHOUT_MONITOR_INTERVAL=3600

# REQUIRED: Your standing MTurk HIT ID for cashouts
# First create a standing HIT on MTurk (see REDEMPTION_CODE_SYSTEM.md for instructions)
# Then paste the HIT ID here
CASHOUT_HIT_ID=

